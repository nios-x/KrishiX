@echo off
echo ===================================================
echo Starting Krishi360 FastAPI Backend Server...
echo API docs available at http://127.0.0.1:8000/docs
echo ===================================================
cd /d "%~dp0\backend"
".venv\Scripts\python.exe" -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload
pause
